# Database Connection (Legacy Prisma / Optional)
DATABASE_URL="file:./dev.db"

# Secret untuk session cookie admin
SESSION_SECRET="genbihub-super-secret-key-upnvjt-2026"

PORT=3000

# ==========================================================
# FIREBASE ADMIN SDK (Firestore Database & Firebase Storage)
# ==========================================================
# Mode Database: biarkan "auto" (otomatis pakai Firestore jika key lengkap terisi,
# atau fallback ke data/genbihub.db.json saat dev offline).
# Set "json" untuk memaksa baca/tulis lokal JSON.
DB_PROVIDER="auto"

# Ambil nilai ini dari file JSON Service Account Firebase Console:
# Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Nama bucket dari menu Build -> Storage (tanpa awalan gs://)
# Contoh: genbihub-upnvjt.firebasestorage.app atau genbihub-upnvjt.appspot.com
FIREBASE_STORAGE_BUCKET=""
