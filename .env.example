# Database Connection (Legacy Prisma / Optional)
DATABASE_URL="file:./dev.db"

# Secret untuk session cookie admin (WAJIB diisi di production, minimal 32 karakter acak).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""

PORT=3000

# Set "true" HANYA jika aplikasi berjalan di belakang reverse proxy (Nginx/Cloudflare) yang
# mengisi header X-Forwarded-For. Dipakai untuk rate limit login per-IP. Jika diakses langsung, biarkan kosong.
TRUST_PROXY=""

# ==========================================================
# FIREBASE ADMIN SDK (Firestore Database & Firebase Storage)
# ==========================================================
# Mode Database: biarkan "auto" (otomatis pakai Firestore jika key lengkap terisi,
# atau fallback ke data/genbihub.db.json saat dev offline).
# Set "json" untuk memaksa baca/tulis lokal JSON.
DB_PROVIDER="auto"

# Ambil nilai ini dari file JSON Service Account Firebase Console:
# Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Nama bucket dari menu Build -> Storage (tanpa awalan gs://)
# Contoh: genbihub-upnvjt.firebasestorage.app atau genbihub-upnvjt.appspot.com
FIREBASE_STORAGE_BUCKET=""

# ==========================================================
# VERCEL BLOB STORAGE (Rekomendasi Serverless Vercel Tanpa Kartu Kredit)
# ==========================================================
# Otomatis terisi saat membuat & menghubungkan Blob Store (Public) di dashboard Vercel.
# Jika terisi, /api/upload otomatis mengunggah gambar & file ke Vercel Blob CDN.
BLOB_READ_WRITE_TOKEN=""
